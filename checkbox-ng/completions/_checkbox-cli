_checkbox_cli_fetch() {
    sh -c 'ids=$("$0" __complete "$1" 2>/dev/null) && [ -n "$ids" ] || exit 0; printf "%s\n" "$ids"; mkdir -p "${2%/*}" 2>/dev/null && printf "%s\n" "$ids" 2>/dev/null > "$2.$$" && mv -f "$2.$$" "$2" 2>/dev/null || rm -f "$2.$$" 2>/dev/null; exit 0' "$@"
}

_checkbox_cli_dynamic() {
    local -a ids
    local file="${XDG_CACHE_HOME:-$HOME/.cache}/checkbox/completion/${words[1]:t}.$1"
    if [[ -s "$file" ]]; then
        ids=(${(f)"$(<"$file")"})
        if [[ -z "$(find "$file" -mmin -1 2>/dev/null)" ]]; then
            touch "$file" 2>/dev/null
            _checkbox_cli_fetch "${words[1]}" "$1" "$file" </dev/null >/dev/null 2>&1 &!
        fi
    else
        ids=(${(f)"$(_checkbox_cli_fetch "${words[1]}" "$1" "$file")"})
    fi
    compadd -a ids
}

_checkbox-cli() {
    local cmd="" i
    for ((i = 2; i < CURRENT; i++)); do
        case ${words[i]} in
            (-*) continue ;;
            (master) cmd=control ;;
            (remote) cmd=control ;;
            (service) cmd=run-agent ;;
            (slave) cmd=run-agent ;;
            (config|check-config|launcher|list|run|startprovider|submit|show|list-bootstrapped|expand|merge-reports|merge-submissions|tp-export|run-agent|control|translate|completion) cmd=${words[i]} ;;
            (*) cmd=launcher ;;
        esac
        break
    done

    local prev=${words[CURRENT-1]} cur=${words[CURRENT]}
    local -a opts values choices; local kind=""
    case $cmd in
        ('')
            opts=(-h --help -v --verbose --debug --clear-cache --clear-old-sessions --version)
            values=(config check-config launcher list run startprovider submit show list-bootstrapped expand merge-reports merge-submissions tp-export run-agent control translate completion)
            kind=file
            ;;
        (config)
            opts=(-h --help)
            values=(check defaults)
            ;;
        (check-config)
            opts=(-h --help)
            kind=file
            ;;
        (launcher)
            case $prev in
                (--title) :; return ;;
                (-m|--message) :; return ;;
            esac
            opts=(-h --help --verify --title -m --message --dont-suppress-output -v --verbose --debug --clear-cache --clear-old-sessions --version)
            kind=file
            ;;
        (list)
            case $prev in
                (-f|--format) :; return ;;
            esac
            opts=(-h --help -a --attrs -f --format)
            values=(category exporter job 'manifest entry' 'packaging meta-data' template 'test plan' file provider storage service all-jobs)
            ;;
        (run)
            case $prev in
                (-f|--output-format) :; return ;;
                (-p|--output-options) :; return ;;
                (-o|--output-file) _files; return ;;
                (-t|--transport) choices=(file stream submission-service); compadd -a choices; return ;;
                (--transport-where) :; return ;;
                (--transport-options) :; return ;;
                (--title) :; return ;;
                (-m|--message) :; return ;;
            esac
            opts=(-h --help --non-interactive -f --output-format -p --output-options -o --output-file -t --transport --transport-where --transport-options --title -m --message --exact)
            kind=units
            ;;
        (startprovider)
            opts=(-h --help --empty)
            ;;
        (submit)
            case $prev in
                (-m|--message) :; return ;;
            esac
            opts=(-h --help -s --staging -m --message)
            kind=file
            ;;
        (show)
            opts=(-h --help --exact)
            kind=units
            ;;
        (list-bootstrapped)
            case $prev in
                (-f|--format) :; return ;;
                (--normal-user) :; return ;;
            esac
            opts=(-h --help --exact -f --format --normal-user)
            kind=test-plans
            ;;
        (expand)
            case $prev in
                (-f|--format) :; return ;;
            esac
            opts=(-h --help -f --format --exact)
            kind=test-plans
            ;;
        (merge-reports)
            case $prev in
                (-o|--output-file) _files; return ;;
            esac
            opts=(-h --help -o --output-file)
            kind=file
            ;;
        (merge-submissions)
            case $prev in
                (-o|--output-file) _files; return ;;
                (--title) :; return ;;
            esac
            opts=(-h --help -o --output-file --title)
            kind=file
            ;;
        (tp-export)
            opts=(-h --help -n --nofake)
            kind=test-plans
            ;;
        (run-agent)
            case $prev in
                (--port) :; return ;;
                (--log-level) choices=(DEBUG INFO WARNING); compadd -a choices; return ;;
            esac
            opts=(-h --help --resume --port --log-level)
            ;;
        (control)
            case $prev in
                (--port) :; return ;;
                (-u|--user) :; return ;;
            esac
            opts=(-h --help --port -u --user --clean)
            kind=file
            ;;
        (translate)
            opts=(-h --help)
            kind=file
            ;;
        (completion)
            opts=(-h --help)
            values=(bash zsh fish)
            ;;
    esac

    if [[ $cur == -* ]]; then
        compadd -a opts
        return
    fi
    (( ${#values} )) && compadd -a values
    case $kind in
        (file) _files ;;
        (test-plans|units) _checkbox_cli_dynamic $kind ;;
    esac
}

if [ "$funcstack[1]" = "_checkbox-cli" ]; then
    _checkbox-cli "$@"
else
    compdef _checkbox-cli checkbox-cli checkbox.checkbox-cli
fi
