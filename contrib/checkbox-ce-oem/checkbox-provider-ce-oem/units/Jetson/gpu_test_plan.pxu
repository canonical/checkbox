id: jetson-gpu-automated
unit: test plan
_name: Jetson GPU automated tests
_description: Automated Jetson GPU tests
include:
    jetson-gpu/nvidia-smi
    jetson-core-gpu/nvidia-smi

id: jetson-cuda-automated
unit: test plan
_name: Jetson CUDA automated tests
_description:
    Automated Jetson CUDA tests. Classic images use the gpgpu provider
    jobs: per-sample jobs when a provision-time cuda-samples build is
    configured (CUDA_SAMPLES_PATH), otherwise the per-set jobs that
    clone and build at test time. Core images use the cuda-samples snap.
include:
    com.canonical.certification::gpgpu/cuda-sample-name
    com.canonical.certification::gpgpu/cuda-samples-0-int
    com.canonical.certification::gpgpu/cuda-samples-1-utils
    com.canonical.certification::gpgpu/cuda-samples-2-conc
    com.canonical.certification::gpgpu/cuda-samples-3-feat
    com.canonical.certification::gpgpu/cuda-samples-4-libs
    com.canonical.certification::gpgpu/cuda-samples-5-dom
    com.canonical.certification::gpgpu/cuda-samples-6-perf
    com.canonical.certification::gpgpu/cuda-samples-7-nvvm
    com.canonical.certification::gpgpu/cuda-samples-8-plat
    jetson-core-gpu/cuda-samples-name
bootstrap_include:
    com.canonical.certification::cuda_prebuilt_state
    com.canonical.certification::cuda_samples_prebuilt
    jetson_cuda_samples_list_core

id: jetson-tensorrt-automated
unit: test plan
_name: Jetson TensorRT automated tests
_description: Automated Jetson TensorRT tests
include:
    jetson-gpu/tensorrt-samples-name
    jetson-core-gpu/tensorrt-samples-name
bootstrap_include:
    jetson_tensorrt_samples_list
    jetson_tensorrt_samples_list_core

id: jetson-cudnn-automated
unit: test plan
_name: Jetson cuDNN automated tests
_description: Automated Jetson cuDNN tests
include:
    jetson-gpu/cudnn/mnistCUDNN
    jetson-gpu/cudnn/conv_sample
    jetson-core-gpu/cudnn/conv
    jetson-core-gpu/cudnn/mnist-cudnn
    jetson-core-gpu/cudnn/multi-head-attention
    jetson-core-gpu/cudnn/rnn
