 from com.canonical.certification import executable
requires:
 executable.name == 'nvpmodel'
command: resource_wrapper.sh -- resource_jetson_nvpmodel_list.sh
_description: Creates resource info for the nvpmodel tests

id: check_jetson_nvpmodel_list_resource
estimated_duration: 0.01
plugin: shell
imports:
  from com.canonical.certification import executable
  from com.canonical.plainbox import manifest
requires:
  manifest.is_Jetson == 'True'
  executable.name == 'nvpmodel'
