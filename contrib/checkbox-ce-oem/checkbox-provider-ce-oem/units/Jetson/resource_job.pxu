id: jetson_tegra_details
estimated_duration: 0.02
plugin: resource
command: resource_wrapper.sh -- resource_jetson_tegra_details.sh
_description: Get the Jetson device details

id: check_jetson_tegra_details_resource
estimated_duration: 0.02
imports:
  from com.canonical.plainbox import manifest
requires:
  manifest.is_Jetson == 'True'
plugin: shell
command: resource_jetson_tegra_details.sh
_description: Verify Jetson device details resource generation command executes directly

id: jetson_lockdown
plugin: resource
_summary: Get kernel lockdown mode
command: resource_wrapper.sh -- resource_jetson_lockdown.sh
_description: Creates a resource that contains the kernel lockdown mode of the device. When EFI secure boot is enabled, this will automatically be set to "integrity"

id: check_jetson_lockdown_resource
imports:
  from com.canonical.plainbox import manifest
requires:
  manifest.is_Jetson == 'True'
plugin: shell
_summary: Check kernel lockdown mode resource generation
command: resource_jetson_lockdown.sh
_description: Verify kernel lockdown mode resource generation command executes directly
