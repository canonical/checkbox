id: xilinx_sku
plugin: resource
_summary: Detect which Xilinx SKU the tool is running on
command: resource_wrapper.sh -- resource_xilinx_sku.sh
estimated_duration: 1s

id: check_xilinx_sku_resource
plugin: shell
_summary: Check Xilinx SKU resource generation
imports: from com.canonical.plainbox import manifest
requires: manifest.is_Xilinx == 'True'
command: resource_xilinx_sku.sh
estimated_duration: 1s
