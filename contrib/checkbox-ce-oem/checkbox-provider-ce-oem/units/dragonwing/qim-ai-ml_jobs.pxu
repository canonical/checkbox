plugin: shell
category_id: dragonwing-qim
imports:
  from com.canonical.certification import executable
  from com.canonical.plainbox import manifest
requires:
  manifest.is_dragonwing_series == 'True'
  executable.name == 'gst-launch-1.0'
id: dragonwing-qim-ai-ml/image-classification-LiteRT-automated
flags: also-after-suspend
environ:
  QIM_TEST_DATA_DIR
  TEST_VIDEO_FILE
  USER_DEFINED_GST_PLUGIN_PATH
  USER_DEFINED_GST_LD_LIBRARY_PATH
_summary: Perform image classification use case with LiteRT runtime
_description:
  Perform image classification use case with LiteRT runtime and check the output video clips
command:
  set -x
  dragonwing_qim_ai_ml_test.py run --runtime litert --scenario image-classification --timeout 20 --test-data-dir "$QIM_TEST_DATA_DIR" --video-path "$TEST_VIDEO_FILE"
_verification:
  check the output image-classification-LiteRT.mp4, no abnormal symptoms are observed

