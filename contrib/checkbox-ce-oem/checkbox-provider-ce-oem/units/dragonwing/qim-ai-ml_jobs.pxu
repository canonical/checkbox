plugin: user-interact-verify
category_id: dragonwing-qim
id: dragonwing-qim-ai-ml/image-classification-LiteRT
flags: also-after-suspend
environ:
  QIM_TEST_DATA_DIR
  TEST_VIDEO_FILE
  USER_DEFINED_GST_PLUGIN_PATH
  USER_DEFINED_GST_LD_LIBRARY_PATH
imports: from com.canonical.plainbox import manifest
requires:
    manifest.is_dragonwing_series == 'True'
_summary: Perform image classification use case with LiteRT runtime - user-interact-verify
_description:
  Perform image classification use case with LiteRT runtime. Checkbox will print the gst-launch pipeline used for testing and generate an output video for review.
estimated_duration: 30s
command:
  set -x
  dragonwing_qim_ai_ml_test.py run --runtime litert --scenario image-classification --test-data-dir "$QIM_TEST_DATA_DIR" --video-path "$TEST_VIDEO_FILE"
_verification:
  Check the generated image-classification-LiteRT.mp4. No abnormal symptoms should be observed.

