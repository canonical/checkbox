plugin: shell
category_id: com.canonical.plainbox::graphics
id: ce-oem-graphics/nvidia-drm-modeset-check
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.has_nvidia_drm_modeset_enable == 'True'
user: root
command: nvidia_drm_modeset_check.py
_summary: Verify Nvidia proprietary driver with DRM modeset for full rendering support
_purpose:
    Verify that the Nvidia card is using the proprietary driver with nvidia-drm modeset enabled,
    ensuring the system can render properly on all Nvidia graphics cards with proprietary drivers.

plugin: shell
category_id: com.canonical.plainbox::graphics
id: ce-oem-graphics/detect_opencl
_summary: Detect OpenCL platform and device availability using clinfo
_purpose:
    Check that at least one OpenCL platform and device are listed by clinfo.
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.has_opencl_support == 'True'
environ: PLAINBOX_PROVIDER_DATA EXECUTABLE_JSON_PATH
command: clinfo_test.py detect


plugin: resource
category_id: com.canonical.plainbox::graphics
id: opencl_clinfo_resource
_summary: Collect OpenCL platform and device pairs from clinfo
_purpose:
    Emit OpenCL platform and device records with an ignore flag for the _verification jobs.
environ: PLAINBOX_PROVIDER_DATA EXECUTABLE_JSON_PATH CLINFO_VALIDATION_JSON_FILE
command:
    resource_wrapper.sh -- clinfo_test.py resource -vjp "${CLINFO_VALIDATION_JSON_FILE:-}"


id: ce-oem-graphics/check-opencl_clinfo_resource
_summary: Check OpenCL Clinfo resource generation
_description:
    Verify OpenCL Clinfo resource generation command executes directly.
estimated_duration: 0.02
category_id: com.canonical.plainbox::graphics
environ: PLAINBOX_PROVIDER_DATA EXECUTABLE_JSON_PATH CLINFO_VALIDATION_JSON_FILE
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.has_opencl_support == 'True'
plugin: shell
command: clinfo_test.py resource -vjp "${CLINFO_VALIDATION_JSON_FILE:-}"


unit: template
template-engine: jinja2
template-resource: opencl_clinfo_resource
template-unit: job
template-id: ce-oem-graphics/opencl-property-validation
template-filter:
    opencl_clinfo_resource.ignore == "false"
id: ce-oem-graphics/opencl-property-validation-{{platform_number}}-{{device_number}}
category_id: com.canonical.plainbox::graphics
_summary: Validate OpenCL properties on platform: '{{platform}}'
_purpose:
    Validate selected OpenCL property values for the platform: '{{platform}}' device: '{{device}} pair
    discovered by the OpenCL resource job.
plugin: shell
estimated_duration: 1s
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.has_opencl_support == 'True'
flags: also-after-suspend
environ: PLAINBOX_PROVIDER_DATA EXECUTABLE_JSON_PATH CLINFO_VALIDATION_JSON_FILE
command:
    clinfo_test.py test \
      -vjp "${CLINFO_VALIDATION_JSON_FILE:-}" \
      -p "{{platform}}" -pn "{{platform_number}}" \
      -d "{{device}}" -dn "{{device_number}}"


plugin: resource
category_id: com.canonical.plainbox::graphics
id: vulkan_vulkaninfo_resource
_summary: Collect hardware GPU devices from vulkaninfo
_purpose:
    Emit one record per hardware GPU device (deviceType DISCRETE_GPU or
    INTEGRATED_GPU) reported by 'vulkaninfo --summary'. Software-only
    devices (e.g. Mesa's llvmpipe/lavapipe CPU device) are never emitted.
environ: PLAINBOX_PROVIDER_DATA EXECUTABLE_JSON_PATH
command:
    resource_wrapper.sh -- vulkaninfo_test.py resource


id: ce-oem-graphics/check-vulkan_vulkaninfo_resource
_summary: Check Vulkan vulkaninfo resource generation
_description:
    Verify Vulkan vulkaninfo resource generation command executes directly.
    Raise error if no GPU type device be found.
estimated_duration: 0.02
category_id: com.canonical.plainbox::graphics
environ: PLAINBOX_PROVIDER_DATA EXECUTABLE_JSON_PATH
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.has_vulkan_support == 'True'
plugin: shell
command: vulkaninfo_test.py resource


unit: template
template-engine: jinja2
template-resource: vulkan_vulkaninfo_resource
template-unit: job
template-id: ce-oem-graphics/vulkan-vulkaninfo-device-validation
id: ce-oem-graphics/vulkan-vulkaninfo-device-validation-GPU{{device_number}}
depends: ce-oem-graphics/check-vulkan_vulkaninfo_resource
category_id: com.canonical.plainbox::graphics
_summary: Validate Vulkan capability on device: '{{device_name}}'
_purpose:
    Validate that the Vulkan stack works correctly for the hardware GPU
    device: '{{device_name}}' discovered by the Vulkan vulkaninfo resource
    job, using 'vulkaninfo --summary'. This fails if there is no output,
    unexpected output (e.g. a segmentation fault) is observed, or a
    software renderer (llvmpipe, softpipe, swrast) is reported for this
    device.
plugin: shell
estimated_duration: 1s
flags: also-after-suspend
environ: PLAINBOX_PROVIDER_DATA EXECUTABLE_JSON_PATH
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.has_vulkan_support == 'True'
command:
    vulkaninfo_test.py test -dn "{{device_number}}" -n "{{device_name}}"


