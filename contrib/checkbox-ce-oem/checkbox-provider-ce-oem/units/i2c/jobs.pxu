plugin: resource
category_id: com.canonical.certification::i2c
id: i2c_read_write_resource
_summary: Resource for specific i2c read and write scenario
_purpose:
    Emit scenario_name for the ce-oem-i2c/specific_i2c_read_write job validation.
environ: PLAINBOX_PROVIDER_DATA I2C_SPECIFIC_SCENARIO_FILE_PATH
command: resource_wrapper.sh -- i2c_read_write.py resource

id: ce-oem-i2c/check-i2c_read_write_resource
_summary: Check specific i2c scenario resource generation
_description:
    Verify specific i2c scenario resource generation command executes directly.
estimated_duration: 0.02
imports:
  from com.canonical.plainbox import manifest
requires:
  manifest.has_specific_i2c_read_write_scenario == 'True'
category_id: com.canonical.certification::i2c
environ: PLAINBOX_PROVIDER_DATA I2C_SPECIFIC_SCENARIO_FILE_PATH
plugin: shell
command: i2c_read_write.py resource --debug

unit: template
template-engine: jinja2
template-resource: i2c_read_write_resource
template-unit: job
template-id: ce-oem-i2c/specific_i2c_read_write
id: ce-oem-i2c/specific-i2c-{{ scenario_name }}
category_id: com.canonical.certification::i2c
_summary: Specific I2c scenraio: {{ scenario_name }}
_purpose:
    Validate devices behind the I2C bus; scenario is '{{ scenario_name }}'
plugin: shell
user: root
imports: from com.canonical.plainbox import manifest
requires: manifest.has_specific_i2c_read_write_scenario == 'True'
estimated_duration: 1s
flags: also-after-suspend
environ: PLAINBOX_PROVIDER_DATA I2C_SPECIFIC_SCENARIO_FILE_PATH
command: i2c_read_write.py test --debug -sn "{{ scenario_name }}"
