id: rz-ai-accelerator/inference
category_id: rz-ai-accelerator
plugin: shell
user: root
_summary: Check if DRP-AI is working
_purpose:
    Check if DRP-AI is working by running an inference sample.
    https://github.com/canonical/rzv_drp-ai_tvm_snap
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.has_rz_drp_ai == 'True'
    manifest.is_rz_series == 'True'
command:
    set -o pipefail
    output_file="$(mktemp /var/tmp/renesas-rz-drp-ai.log)"
    trap 'rm -f "$output_file"' EXIT
    if ! rzv-drp-ai-tvm-examples.tutorial-app 2>&1 | tee "$output_file"; then
        echo "Fail: tutorial-app exited with non-zero status"
        exit 1
    fi
    echo "Checking for CPU-only fallback or errors ..."
    if grep -Eq "CPU-only model|\[ERROR\]" "$output_file"; then
        echo "Fail: Running by CPU-only model or error!"
        exit 1
    fi
    echo "Success: Running by DRP-AI without error!"

id: rz-ai-accelerator/driver-nodes-drp-ai
category_id: rz-ai-accelerator
plugin: shell
user: root
_summary: Check DRP-AI device nodes are present
_purpose:
    Check that the DRP-AI kernel device nodes are present,
    as a fast driver-level smoke test ahead of the
    application-level inference test.
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.is_rz_series == 'True'
    manifest.has_rz_drp_ai == 'True'
command:
    for dev in /dev/drpai0 /dev/udmabuf /dev/rgnmm /dev/rgnmmbuf; do
        if [ ! -e "$dev" ]; then
            echo "Fail: missing $dev"
            exit 1
        fi
        echo "Found: $dev"
    done
    echo "Success: all DRP-AI device nodes present"

id: rz-ai-accelerator/driver-nodes-drp-ai3
category_id: rz-ai-accelerator
plugin: shell
user: root
_summary: Check DRP-AI3 device nodes are present
_purpose:
    Check that the DRP-AI3 kernel device nodes are present, as a fast
    driver-level smoke test ahead of the application-level
    object-counter test.
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.is_rz_series == 'True'
    manifest.has_rz_drp_ai3 == 'True'
command:
    for dev in /dev/drpai0 /dev/udmabuf /dev/rgnmm /dev/rgnmmbuf; do
        if [ ! -e "$dev" ]; then
            echo "Fail: missing $dev"
            exit 1
        fi
        echo "Found: $dev"
    done
    if [ -e /dev/drp1 ]; then
        echo "Info: optional /dev/drp1 present"
    else
        echo "Info: optional /dev/drp1 not present on this device"
    fi
    echo "Success: all required DRP-AI3 device nodes present"
