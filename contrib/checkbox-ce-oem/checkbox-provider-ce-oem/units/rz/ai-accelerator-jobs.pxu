id: rz-ai-accelerator/inference
category_id: rz-ai-accelerator
plugin: shell
user: root
_summary: Check if DRP-AI is working
_purpose:
    Check if DRP-AI is working by running an inference sample.
    https://github.com/canonical/rzv_drp-ai_tvm_snap
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.has_rz_drp_ai == 'True'
    manifest.is_rz_series == 'True'
command:
    set -o pipefail
    output_file="$(mktemp /var/tmp/renesas-rz-drp-ai.XXXXXX)"
    trap 'rm -f "$output_file"' EXIT
    if ! rzv-drp-ai-tvm-examples.tutorial-app 2>&1 | tee "$output_file"; then
        echo "Fail: tutorial-app exited with non-zero status"
        exit 1
    fi
    echo "Checking for CPU-only fallback or errors ..."
    if grep -Eq "CPU-only model|\[ERROR\]" "$output_file"; then
        echo "Fail: Running by CPU-only model or error!"
        exit 1
    fi
    echo "Success: Running by DRP-AI without error!"

id: rz-ai-accelerator/driver-nodes-drp-ai
category_id: rz-ai-accelerator
plugin: shell
user: root
_summary: Check DRP-AI (V2L) device nodes are present
_purpose:
    Check that the DRP-AI (single-core, V2L) kernel device nodes are
    present, as a fast driver-level smoke test ahead of the
    application-level inference test. Confirmed on real V2L hardware
    (CID 202507-36926): V2L does NOT have /dev/drp1 (that node only
    exists on the dual-core DRP-AI3 used by V2H/V2N), so this is a
    separate job from driver-nodes-drp-ai3 rather than a single
    OR-gated job across both generations.
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.is_rz_series == 'True'
    manifest.has_rz_drp_ai == 'True'
command:
    for dev in /dev/drpai0 /dev/udmabuf /dev/rgnmm /dev/rgnmmbuf; do
        if [ ! -e "$dev" ]; then
            echo "Fail: missing $dev"
            exit 1
        fi
    done
    echo "Success: all DRP-AI device nodes present"

id: rz-ai-accelerator/driver-nodes-drp-ai3
category_id: rz-ai-accelerator
plugin: shell
user: root
_summary: Check DRP-AI3 (V2H/V2N) device nodes are present
_purpose:
    Check that the DRP-AI3 (dual-core, V2H/V2N) kernel device nodes
    are present, as a fast driver-level smoke test ahead of the
    application-level object-counter test. Confirmed on real V2H
    hardware (CID 202503-36406): all five nodes below exist there.
imports:
    from com.canonical.plainbox import manifest
requires:
    manifest.is_rz_series == 'True'
    manifest.has_rz_drp_ai3 == 'True'
command:
    for dev in /dev/drpai0 /dev/drp1 /dev/udmabuf /dev/rgnmm /dev/rgnmmbuf; do
        if [ ! -e "$dev" ]; then
            echo "Fail: missing $dev"
            exit 1
        fi
    done
    echo "Success: all DRP-AI3 device nodes present"
