id: ce-oem-switchdev-ports
_summary: Enumerate switchdev fabric ports
_description:
    Generates the list of netdevs exposing phys_switch_id (switch fabric
    ports). Ports listed in checkbox config SWITCHDEV_RESERVED_PORTS
    (space-separated names, e.g. the management/infra uplink) are marked
    reserved: True so destructive templates exclude them.
plugin: resource
category_id: com.canonical.plainbox::ethernet
estimated_duration: 2
environ: SWITCHDEV_RESERVED_PORTS
command: switchdev_test.py resource

id: ce-oem-switchdev/port-count
_summary: Check the expected number of switchdev fabric ports enumerate
_description:
    Counts netdevs with phys_switch_id and compares against checkbox config
    SWITCHDEV_EXPECTED_PORTS (e.g. 29 = 24 copper + 4 SFP+ + management on a
    Tactical-1000 class device).
plugin: shell
user: root
category_id: com.canonical.plainbox::ethernet
estimated_duration: 5
environ: SWITCHDEV_EXPECTED_PORTS
command:
    if [ -z "$SWITCHDEV_EXPECTED_PORTS" ]; then
        echo "FAIL: set SWITCHDEV_EXPECTED_PORTS in the checkbox config"
        exit 1
    fi
    switchdev_test.py port-count --expected "$SWITCHDEV_EXPECTED_PORTS"

unit: template
template-resource: ce-oem-switchdev-ports
template-filter: ce-oem-switchdev-ports.reserved == 'False'
template-unit: job
template-id: ce-oem-switchdev/link-flap
id: ce-oem-switchdev/link-flap-{interface}
_summary: Admin link flap recovery on fabric port {interface}
_description:
    Repeatedly admin-down/up the port and verify the link recovers each
    time. Ports without link at start (empty ports) pass as skip. Reserved
    infra ports are excluded by the template filter.
plugin: shell
user: root
category_id: com.canonical.plainbox::ethernet
estimated_duration: 60
command: switchdev_test.py link-flap --interface {interface}

id: ce-oem-switchdev/vlan-config-drift
_summary: Frozen bridge VLAN table matches the saved baseline
_description:
    The standing rig freezes the bridge/VLAN layout in the boot config.
    This job diffs the live `bridge vlan` table against the baseline JSON at
    checkbox config SWITCHDEV_VLAN_BASELINE. Create the baseline once on a
    known-good rig with:
    switchdev_test.py vlan-drift --baseline <path> --save
plugin: shell
user: root
category_id: com.canonical.plainbox::ethernet
estimated_duration: 5
environ: SWITCHDEV_VLAN_BASELINE
imports: from com.canonical.plainbox import manifest
requires: manifest.has_switchdev_standing_rig == 'True'
command: switchdev_test.py vlan-drift --baseline "$SWITCHDEV_VLAN_BASELINE"

id: ce-oem-switchdev/chain-offload-proof
_summary: Chain traffic is forwarded by the switch ASIC (offload proof)
_description:
    Sends iperf3 UDP from the chain-entry SVI to the chain-exit SVI (moved
    into a netns) so traffic traverses the standing loop-cable chain, then
    asserts: traffic arrived (loss below threshold), hardware-offloaded FDB
    entries exist, and a mid-chain fabric port actually carried the packets.
    Requires iperf3 on the device and the standing rig VLAN plan.
plugin: shell
user: root
category_id: com.canonical.plainbox::ethernet
estimated_duration: 60
environ: SWITCHDEV_BRIDGE SWITCHDEV_CHAIN_ENTRY_SVI SWITCHDEV_CHAIN_EXIT_SVI SWITCHDEV_CHAIN_ENTRY_IP SWITCHDEV_CHAIN_EXIT_IP SWITCHDEV_CHAIN_MID_PORT SWITCHDEV_CHAIN_RATE
imports: from com.canonical.plainbox import manifest
requires: manifest.has_switchdev_standing_rig == 'True'
command:
    switchdev_test.py offload-proof \
        --bridge "${SWITCHDEV_BRIDGE:-br0}" \
        --entry-svi "$SWITCHDEV_CHAIN_ENTRY_SVI" \
        --exit-svi "$SWITCHDEV_CHAIN_EXIT_SVI" \
        --entry-ip "$SWITCHDEV_CHAIN_ENTRY_IP" \
        --exit-ip "$SWITCHDEV_CHAIN_EXIT_IP" \
        --mid-port "$SWITCHDEV_CHAIN_MID_PORT" \
        --rate "${SWITCHDEV_CHAIN_RATE:-500M}"

id: ce-oem-switchdev/rstp-loop-protection
_summary: STP contains the pre-provisioned loop and fails over
_description:
    Brings up the standing same-VLAN cabled fixture pair (admin-down by
    default) with kernel STP enabled: one port must go blocking (loop
    contained), and admin-downing the forwarding port must promote the
    blocked one. Restores ports down and the bridge STP state afterwards.
plugin: shell
user: root
category_id: com.canonical.plainbox::ethernet
estimated_duration: 300
environ: SWITCHDEV_BRIDGE SWITCHDEV_RSTP_FIXTURE_PORTS
imports: from com.canonical.plainbox import manifest
requires: manifest.has_switchdev_rstp_fixture == 'True'
command:
    # shellcheck disable=SC2086
    switchdev_test.py rstp-fixture --bridge "${SWITCHDEV_BRIDGE:-br0}" --ports $SWITCHDEV_RSTP_FIXTURE_PORTS

id: ce-oem-switchdev/l3-offload-probe
_summary: Report whether L3 routes are hardware-offloaded (informational)
_description:
    Informational probe: reports whether any kernel route carries the
    offload flag. On devices whose driver lacks L3 offload this documents
    the CPU-path routing status per release; it never fails the run.
plugin: shell
user: root
category_id: com.canonical.plainbox::ethernet
estimated_duration: 5
command: switchdev_test.py l3-offload-probe

id: ce-oem-switchdev/vrf-probe
_summary: Report whether VRF creation is supported (informational)
_description:
    Informational probe: tries to create and delete a VRF device and
    reports driver/kernel support status; it never fails the run.
plugin: shell
user: root
category_id: com.canonical.plainbox::ethernet
estimated_duration: 5
command: switchdev_test.py vrf-probe
