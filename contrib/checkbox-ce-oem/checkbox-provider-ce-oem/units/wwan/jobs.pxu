unit: job
id: ce-oem-wwan/usb-hotspot-auto
_summary: Verify a USB cdc-acm WWAN module can create a data connection
_purpose:
  Verifies that a WWAN module attached as a USB cdc-acm device (used
  purely to bring up a connection, USB-hotspot style) can create a
  data connection. Unlike a ModemManager-integrated modem, this module
  isn't discovered by a resource job, so this test always runs once
  per system rather than once per detected modem.
  .
  The test is driven by the WWAN_AT_COMMAND_JSON environment variable,
  which names a JSON config file (see
  usb_hotspot_connection_at_command.py). A bare filename (e.g.
  SIM7672G-LNGV_wwan_at_command.json) is looked up under
  $PLAINBOX_PROVIDER_DATA/wwan_at_command/; a full path is used as-is.
  The config has two independently-optional parts: "setup" (shell
  commands to bring the module up) and "connect" (AT commands sent
  over WWAN_CONTROL_IF to make the connection). With no config (or
  both parts empty), the job simply pings over WWAN_NET_IF.
plugin: shell
command:
  BEGIN_TEST_TS=$(date '+%Y-%m-%d %H:%M:%S')
  usb_hotspot_connection_at_command.py
  RETVAL=$?
  if [ $RETVAL -ne 0 ]; then
    echo "==== journalctl since test start ===="
    journalctl -q --no-pager --since "$BEGIN_TEST_TS" -o cat
    exit $RETVAL
  fi
environ: LD_LIBRARY_PATH WWAN_CONTROL_IF WWAN_NET_IF WWAN_APN WWAN_SETUPTIME WWAN_AT_COMMAND_JSON
user: root
estimated_duration: 10.0
category_id: com.canonical.certification::wwan
flags: preserve-locale also-after-suspend preserve-cwd
imports:
  from com.canonical.plainbox import manifest
requires:
  manifest.has_wwan_module == 'True'
  manifest.has_sim_card == 'True'
  manifest.has_wwan_hotspot == 'True'

unit: job
id: ce-oem-wwan/usb-hotspot-recovery-auto
_summary: Verify a USB cdc-acm WWAN module recovers its data connection
_purpose:
  Issues a modem software reset (AT+CRESET) and verifies the modem
  re-enumerates over USB and re-registers on the network afterwards,
  falling back to an AT+CFUN radio cycle if registration stays denied.
  This is a separate, longer-running test from the base connection
  test, so it only runs on projects/devices whose manifest opts into
  WWAN reset/recovery testing.
plugin: shell
command:
  BEGIN_TEST_TS=$(date '+%Y-%m-%d %H:%M:%S')
  usb_hotspot_connection_at_command.py --action reset-recovery
  RETVAL=$?
  if [ $RETVAL -ne 0 ]; then
    echo "==== journalctl since test start ===="
    journalctl -q --no-pager --since "$BEGIN_TEST_TS" -o cat
    exit $RETVAL
  fi
environ: LD_LIBRARY_PATH WWAN_CONTROL_IF WWAN_RESET_WAIT WWAN_RESET_COPS_TIMEOUT WWAN_RESET_DENIED_TIMEOUT WWAN_RESET_RADIO_CYCLE_WAIT
user: root
estimated_duration: 240.0
category_id: com.canonical.certification::wwan
flags: preserve-locale also-after-suspend preserve-cwd
imports:
  from com.canonical.plainbox import manifest
depends: ce-oem-wwan/usb-hotspot-auto
requires:
  manifest.has_wwan_module == 'True'
  manifest.has_sim_card == 'True'
  manifest.has_wwan_hotspot == 'True'
depends: ce-oem-wwan/usb-hotspot-auto
