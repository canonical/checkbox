id: cuda/samples-readiness
category_id: cuda
flags: simple
_summary: Check the prebuilt cuda-samples tree is present, built and version-matched
_description:
 Fails when no cuda-samples tree is found, when the tree contains no
 built sample binaries (this suite is prebuilt-only and never builds),
 or when a git checkout is not at the newest cuda-samples tag that is
 lower than or equal to the CUDA version reported by nvidia-smi.
estimated_duration: 10s
imports: from com.canonical.plainbox import manifest
requires: manifest.has_nvidia_cuda == 'True'
environ: CUDA_SAMPLES_PATH CUDA_SAMPLES_EXCLUDE_FILE
command: cuda_samples.py readiness

unit: template
template-resource: cuda_samples_resource
template-unit: job
template-id: cuda-sample/category-name
_template-summary: Run one prebuilt cuda-samples test per sample
id: cuda-sample/{category}-{name}
category_id: cuda
flags: simple
depends: cuda/samples-readiness
imports: from com.canonical.plainbox import manifest
requires:
 manifest.has_nvidia_cuda == 'True'
 (cuda_samples_resource.name == '{name}' and cuda_samples_resource.category == '{category}' and cuda_samples_resource.skip == 'False')
environ: CUDA_SAMPLES_PATH CUDA_SAMPLES_TIMEOUT
_summary: Run cuda-samples {category}/{name}
estimated_duration: 30s
command: cuda_samples.py run '{category}' '{name}'
